<%= render layout: "shared/window", locals: { title: @tag ? "Posts tagged #{@tag.name}" : "All posts", heading: :h1 } do %>
  <% if @posts.present? %>
    <ul class="entries entries-lg">
      <%= render partial: "posts/entry", collection: @posts %>
    </ul>
  <% else %>
    <p>Nothing written yet.</p>
  <% end %>

  <%= render "shared/pager", records: @posts, noun: "posts" %>
<% end %>
