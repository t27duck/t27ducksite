<%= render layout: "shared/window", locals: { title: "Projects", heading: :h1, html_class: "admin" } do %>
  <p class="toolbar">
    <%= link_to "New Project", new_admin_project_path, class: "button" %>
    <%= link_to "Posts", admin_posts_path, class: "button" %>
  </p>

  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Type</th>
        <th>Created at</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @projects.each do |project| %>
        <tr>
          <td><%= project.title.html_safe %></td>
          <td><%= project.kind.titleize %></td>
          <td><%= project.created_at %></td>
          <td nowrap>
            <%= link_to "Edit", edit_admin_project_path(project) %>
            <%= link_to "Delete", admin_project_path(project), data: { turbo_method: "delete", turbo_confirm: "Are you sure?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
