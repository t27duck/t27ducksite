<%= render layout: "shared/window", locals: { title: "Pages", heading: :h1, html_class: "admin" } do %>
  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Slug</th>
        <th>Updated at</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @pages.each do |page| %>
        <tr>
          <td><%= formatted_title(page.title) %></td>
          <td><%= page.slug %></td>
          <td><%= page.updated_at %></td>
          <td nowrap>
            <%= link_to "Edit", edit_admin_page_path(page) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
