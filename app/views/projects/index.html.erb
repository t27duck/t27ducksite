<%= render layout: "shared/window", locals: { title: "All projects", heading: :h1 } do %>
  <% if @projects.present? %>
    <ul class="entries entries-lg">
      <% @projects.each do |project| %>
        <li>
          <h2 class="entry-title"><%= link_to formatted_title(project.title), project %></h2>
          <p class="meta">
            <span class="kind"><%= project.kind.titleize %></span><% if project.agentic? %>, AI-assisted<% end %>
          </p>
          <div class="entry-summary"><%= project_description(project) %></div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No projects yet.</p>
  <% end %>
<% end %>
