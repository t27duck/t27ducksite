<%= render layout: "shared/window", locals: { title: "All talks", heading: :h1 } do %>
  <% if @talks.present? %>
    <ul class="entries entries-lg">
      <% @talks.each do |talk| %>
        <li>
          <h2 class="entry-title"><%= link_to talk.title.html_safe, talk %></h2>
          <% if talk.summary.present? %>
            <p class="entry-summary"><%= talk.summary %></p>
          <% end %>
          <%= render "posts/video", post: talk %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No talks posted yet.</p>
  <% end %>

  <%= render "shared/pager", records: @talks, noun: "talks" %>
<% end %>
