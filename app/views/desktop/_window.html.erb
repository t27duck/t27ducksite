<dialog class="window desktop-window" data-action="pointerdown->desktop#raise close->desktop#discard">
  <div class="titlebar" data-action="pointerdown->desktop#grab pointermove->desktop#drag pointerup->desktop#drop">
    <h2>Untitled</h2>
    <form method="dialog">
      <button class="close" title="Close" aria-label="Close">
        <svg viewBox="0 0 8 8" aria-hidden="true"><path d="M1 1l6 6M7 1 1 7" stroke="currentColor" stroke-width="1.75" /></svg>
      </button>
    </form>
  </div>
  <div class="window-body"></div>
</dialog>
