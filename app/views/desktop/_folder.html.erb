<%# locals: (title:) %>
<%# A folder icon and the Explorer window it opens. Files open as full pages, hence target _top. %>

<% folder = title.parameterize %>

<button type="button" class="desktop-icon" data-action="desktop#requireDoubleClick desktop#open" data-desktop-window-param="<%= folder %>-window">
  <%= image_tag "folder.svg", alt: "" %>
  <span><%= title %></span>
</button>

<%= render layout: "desktop/window", locals: { id: "#{folder}-window", title:, html_class: "explorer" } do %>
  <%= turbo_frame_tag "#{folder}-folder", src: desktop_folder_path(folder), loading: :lazy, target: "_top" do %>
    Loading…
  <% end %>
<% end %>
