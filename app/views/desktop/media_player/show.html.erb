<%= turbo_frame_tag "media-player" do %>
  <nav class="menubar" aria-label="Media Player">
    <div>
      <button type="button" class="menubar-item" popovertarget="media-player-file-menu">File</button>
      <div id="media-player-file-menu" class="menu" popover>
        <button type="button" command="show-modal" commandfor="media-player-open">Open…</button>
        <form method="dialog">
          <button>Exit</button>
        </form>
      </div>
    </div>
  </nav>
  <div class="screen">
    <% if @talk %>
      <%= render "posts/youtube_embed", post: @talk %>
    <% else %>
      <p>No media</p>
    <% end %>
  </div>
  <% if @talk %>
    <div class="status">
      <strong><%= formatted_title(@talk.title) %></strong>
      <p>
        <span><%= @talk.published_at.strftime("%B %-d, %Y") %></span>
        <%= link_to "Watch on YouTube", @talk.video_url, target: "_blank", rel: "noopener" %>
      </p>
    </div>
  <% end %>

  <%= render "desktop/open_dialog", id: "media-player-open", src: desktop_media_player_files_path, look_in: "Talks" %>
<% end %>
